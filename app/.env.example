# ShopPilot AI — environment (see ../docs/env_setup.md §4 for the full table)
# Copy to .env and adjust. Nothing here is required for the demo defaults to work.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:4000
LOG_LEVEL=info

# ── Storage ────────────────────────────────────────────────────────────────
# This reference build ships a file-backed store that mirrors the Mongo schema in
# ../docs/data_model.md. Set MONGO_URI to switch to a real MongoDB (documented, driver
# stub is in server/store/mongo.driver.mjs).
DATA_DIR=.data
# MONGO_URI is reserved: setting it makes the server refuse to boot rather than
# pretend persistence works. The bundled file store mirrors the Mongo schema.
MONGO_URI=

# ── Auth / sessions ────────────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me-32-bytes-minimum-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
GUEST_SESSION_TTL=30d
SESSION_COOKIE_NAME=sid
COOKIE_SECURE=false
PII_HASH_PEPPER=dev-only-another-long-random-pepper-string

# ── Payments ───────────────────────────────────────────────────────────────
# PAYPAL_MODE=simulator  → in-process PayPal sandbox simulator (no credentials, runnable demo)
# PAYPAL_MODE=sandbox    → real PayPal Orders v2 against api-m.sandbox.paypal.com
PAYPAL_MODE=simulator
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ── Multi-seller settlement (docs/payments_paypal.md, WIN_PLAN F1) ───────────
# auto   → ask for a split per seller; if the account lacks the capability, fall back to one unit
#          and record why (never silently pretends a split happened)
# split  → always build one purchase unit per seller with `payee` + `platform_fees`
# single → one unit for the whole basket (the pre-F1 behaviour)
PAYPAL_SETTLEMENT=auto
# ShopPilot's commission per seller unit, in basis points (500 = 5%)
PLATFORM_FEE_BPS=500
# INSTANT pays each seller as the order is captured; DELAYED holds funds until you release them
PAYPAL_DISBURSEMENT_MODE=INSTANT
# Simulator only: behave like an account NOT enabled for multi-seller payments, so the
# `auto` fallback path is testable without real credentials. Leave false for demos.
PAYPAL_SIM_SPLIT_UNSUPPORTED=false
PAYPAL_SIM_FEES_UNSUPPORTED=false
PAYPAL_TIMEOUT_MS=10000
# Overrides the PayPal Orders v2 base URL. Point it at a local fake to exercise the
# real sandbox client (auth failures, retries, error mapping) without calling PayPal.
PAYPAL_API_BASE_URL=
PAYMENT_MAX_ATTEMPTS=3
QUOTE_TTL_MINUTES=15

# ── Agent / LLM ────────────────────────────────────────────────────────────
# FEATURE_LIVE_LLM=false → deterministic planner (same tool registry + SSE frames, no API key)
# FEATURE_LIVE_LLM=true  → a real tool-calling model. The deployed demo runs Groq.
FEATURE_LIVE_LLM=false
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
# Loop budgets — the agent is bounded on every axis.
LLM_MAX_ITERATIONS=6
LLM_PER_CALL_TIMEOUT_MS=8000
LLM_TURN_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2
BUDGET_GRACE_BPS=300
CLARIFY_MAX_QUESTIONS=2

# ── Business rules ─────────────────────────────────────────────────────────
TAX_RATE_BPS=825
SHIPPING_FREE_THRESHOLD_MINOR=50000
SHIPPING_STANDARD_MINOR=999
SHIPPING_SMALL_ORDER_MINOR=1499
MAX_CART_LINES=20
MAX_LINE_QTY=10

# ── Flags & limits ─────────────────────────────────────────────────────────
FEATURE_ANALYTICS=true
FEATURE_GUEST_ORDERS=true
RATE_CHAT=60/5m
RATE_AUTH=20/15m
RATE_CHECKOUT=30/5m
RATE_PAYMENT=30/5m
RATE_GLOBAL=600/1m
