{
  "name": "shoppilot-ai-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ShopPilot AI reference implementation \u2014 conversational shopping with grounded recommendations and a verified PayPal checkout. Implements the contracts in ../prd.md, ../docs/api_spec.md, ../docs/ai_agent_spec.md and ../docs/payments_paypal.md.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset.mjs",
    "demo": "node scripts/demo.mjs",
    "art": "node scripts/generate-product-art.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:evals": "node scripts/run-tests.mjs evals",
    "ledger": "node scripts/ledger-check.mjs",
    "test:count": "node scripts/test-count.mjs --check",
    "test:count:write": "node scripts/test-count.mjs --write",
    "verify": "node scripts/verify.mjs",
    "verify:demo": "npm run reset && npm run verify",
    "paypal:check": "node scripts/paypal-sandbox-check.mjs",
    "paypal:settlement": "node scripts/paypal-settlement-check.mjs",
    "photos": "node scripts/import-product-photos.mjs",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
